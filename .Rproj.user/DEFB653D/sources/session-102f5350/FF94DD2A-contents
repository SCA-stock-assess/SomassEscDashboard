---

```{r setup, include=FALSE}
library(flexdashboard)
library(readxl)
library(tidyverse)
library(plotly)

# ---- shared theme for all charts ----
somass_theme <- theme_minimal(base_size = 13) +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    legend.title = element_blank(),
    plot.title = element_text(face = "bold", size = 14, margin = margin(b = 8)),
    axis.title.y = element_text(margin = margin(r = 8))
  )

somass_pal <- c(
  "Chinook"     = "#2C5F7C",
  "ChinookJack" = "#8FB9CC",
  "Coho"        = "#C2542C",
  "CohoJack"    = "#E8A87C"
)

# ---- data ----
SomassEscAnnual <- read_xlsx(
  "//dcbcpbsna01a.ENT.dfo-mpo.ca/PBS_SA_DFS$/SCD_Stad/WCVI/Sockeye/SOMASS/Data/ESCAPEMENT_PROGRAM/SomassEsc.xlsx",
  sheet = "Stamp CN & CO",
  na = ""
) |>
  select(1:9) |>
  pivot_longer(cols = Coho:ChinookJack, names_to = "species", values_to = "count") |>
  rename_with(tolower) |>
  mutate(date = as.Date(date)) |>
  group_by(year, species) |>
  summarise(annual_escapement = sum(count, na.rm = TRUE), .groups = "drop")
```

# Overview

## Column {data-width="650"}

### Chinook Escapement (Stamp River)

```{r}
p_a <- SomassEscAnnual %>% 
  filter(species %in% c("Chinook", "ChinookJack")) %>% 
  ggplot(aes(x = year, y = annual_escapement, fill = species,
             text = paste0("Year: ", year,
                            "<br>Species: ", species,
                            "<br>Escapement: ", scales::comma(annual_escapement)))) +
  geom_col(position = "stack") +
  scale_fill_manual(values = somass_pal) +
  labs(title = "Chinook & Chinook Jack Escapement", x = NULL, y = "Escapement") +
  somass_theme

ggplotly(p_a, tooltip = "text") %>% 
  layout(legend = list(orientation = "h", y = -0.15, title = list(text = "")))
```

