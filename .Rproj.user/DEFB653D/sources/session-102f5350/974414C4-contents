```{r setup, include=FALSE}
knitr::opts_chunk$set(out.width = "100%")

library(flexdashboard)
library(readxl)
library(tidyverse)
library(plotly)

# ---- shared theme for all charts ----
somass_theme <- theme_minimal(base_size = 13) +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    legend.title = element_blank(),
    plot.title = element_text(face = "bold", size = 14, margin = margin(b = 8)),
    axis.title.y = element_text(margin = margin(r = 8))
  )

somass_pal <- c(
  "Chinook"     = "#2C5F7C",
  "ChinookJack" = "#8FB9CC",
  "Coho"        = "#C2542C",
  "CohoJack"    = "#E8A87C",
  "Sockeye"     = "#3E7C5A",
  "SockeyeJack" = "#96C6A8"
)

# ---- data ----
SomassEscAnnual <- read_xlsx(
  "//dcbcpbsna01a.ENT.dfo-mpo.ca/PBS_SA_DFS$/SCD_Stad/WCVI/Sockeye/SOMASS/Data/ESCAPEMENT_PROGRAM/SomassEsc.xlsx",
  sheet = "Stamp CN & CO",
  na = ""
) |>
  select(1:9) |>
  pivot_longer(cols = Coho:ChinookJack, names_to = "species", values_to = "count") |>
  rename_with(tolower) |>
  mutate(date = as.Date(date)) |>
  group_by(year, species) |>
  summarise(annual_escapement = sum(count, na.rm = TRUE), .groups = "drop")

SomassSockeyeAnnual <- read_xlsx(
  "//dcbcpbsna01a.ENT.dfo-mpo.ca/PBS_SA_DFS$/SCD_Stad/WCVI/Sockeye/SOMASS/Data/ESCAPEMENT_PROGRAM/SomassEsc.xlsx",
  sheet = "Sockeye",
  na = ""
) |>
  select(1:7) |>
  rename(Sockeye = 6, SockeyeJack = 7) |>
  pivot_longer(cols = c(Sockeye, SockeyeJack), names_to = "species", values_to = "count") |>
  rename_with(tolower, -species) |>
  mutate(date = make_date(year, month, day)) |>
  group_by(year, system, species) |>
  summarise(annual_escapement = sum(count, na.rm = TRUE), .groups = "drop")

# helper to build a full-panel interactive stacked bar, jacks on top
make_escapement_plot <- function(data, species_levels, title = "") {
  plot_data <- data %>% 
    filter(species %in% species_levels) %>% 
    mutate(species = factor(species, levels = species_levels))

  p <- ggplot(plot_data, aes(
      x = year, y = annual_escapement, fill = species,
      text = paste0("Year: ", year,
                     "<br>Species: ", species,
                     "<br>Escapement: ", scales::comma(annual_escapement))
    )) +
    geom_col(position = position_stack(reverse = TRUE)) +
    scale_fill_manual(values = somass_pal) +
    labs(title = title, x = NULL, y = "Escapement") +
    somass_theme

  ggplotly(p, tooltip = "text") %>% 
    layout(
      autosize = TRUE,
      legend = list(orientation = "h", y = -0.15, title = list(text = ""))
    ) %>% 
    config(responsive = TRUE)
}

# helper: line comparison of adults only across systems
make_system_comparison_plot <- function(data, systems, species_name, title = "") {
  plot_data <- data %>% 
    filter(system %in% systems, species == species_name) %>% 
    arrange(year)

  system_pal <- c("GCL" = "#3E7C5A", "Sproat" = "#B5763E")

  plot_ly(plot_data, x = ~year, y = ~annual_escapement, color = ~system,
          colors = system_pal, type = "scatter", mode = "lines+markers",
          line = list(width = 3), marker = list(size = 7),
          hovertemplate = paste0(
            "<b>%{fullData.name}</b><br>Year: %{x}",
            "<br>Escapement: %{y:,.0f}<extra></extra>"
          )) %>% 
    layout(
      title = list(text = title, font = list(size = 14, face = "bold")),
      xaxis = list(title = ""),
      yaxis = list(title = "Adult Escapement", rangemode = "tozero"),
      legend = list(orientation = "h", y = -0.15, title = list(text = "")),
      autosize = TRUE
    ) %>% 
    config(responsive = TRUE)
}

# helper: adults as bars, jacks as a line on a secondary axis (per system)
make_combo_plot <- function(data, system_name, adult_color, jack_color, title = "") {
  adult_data <- data %>% filter(system == system_name, species == "Sockeye") %>% arrange(year)
  jack_data  <- data %>% filter(system == system_name, species == "SockeyeJack") %>% arrange(year)

  plot_ly() %>% 
    add_bars(
      data = adult_data, x = ~year, y = ~annual_escapement,
      name = "Adult", marker = list(color = adult_color),
      hovertemplate = "Year: %{x}<br>Adult: %{y:,.0f}<extra></extra>"
    ) %>% 
    add_trace(
      data = jack_data, x = ~year, y = ~annual_escapement,
      name = "Jack", type = "scatter", mode = "lines+markers",
      yaxis = "y2", line = list(color = jack_color, width = 3),
      marker = list(color = jack_color, size = 7),
      hovertemplate = "Year: %{x}<br>Jack: %{y:,.0f}<extra></extra>"
    ) %>% 
    layout(
      title = list(text = title, font = list(size = 14, face = "bold")),
      xaxis = list(title = ""),
      yaxis = list(title = "Adult Escapement", rangemode = "tozero"),
      yaxis2 = list(title = "Jack Escapement", overlaying = "y", side = "right", rangemode = "tozero"),
      legend = list(orientation = "h", y = -0.15, title = list(text = "")),
      autosize = TRUE
    ) %>% 
    config(responsive = TRUE)
}
